# Cinebase GraphQL schema — served by movie-service.
# movie-service is the single frontend API; people/cast/creator data is
# resolved from person-service over gRPC.

scalar DateTime
scalar Date
scalar Upload

type Query {
  # Movies
  movies(search: String, sort: MovieSort, page: Int, size: Int): MoviePage!
  movie(id: ID!): Movie

  # People (resolved via person-service gRPC)
  people(search: String, page: Int, size: Int): PersonPage!
}

type Mutation {
  # Movies
  createMovie(input: MovieInput!): Movie!
  updateMovie(id: ID!, input: MovieInput!): Movie!
  deleteMovie(id: ID!): Boolean!

  # People
  createPerson(input: PersonInput!): Person!
  updatePerson(id: ID!, input: PersonInput!): Person!
  deletePerson(id: ID!): Boolean!

  # Cast
  addCastMember(input: CastInput!): MovieCast!
  updateCastMember(id: ID!, input: CastInput!): MovieCast!
  removeCastMember(id: ID!): Boolean!

  # Creators
  addCreator(input: CreatorInput!): MovieCreator!
  updateCreator(id: ID!, input: CreatorInput!): MovieCreator!
  removeCreator(id: ID!): Boolean!

  # Artwork
  uploadMovieArtwork(movieId: ID!, type: ArtworkType!, file: Upload!): Artwork!
  removeMovieArtwork(id: ID!): Boolean!
}

type Movie {
  id: ID!
  title: String!
  synopsis: String
  releaseYear: Int
  genre: String
  artworkUrl: String
  artworks: [Artwork!]!
  cast: [MovieCast!]!
  creators: [MovieCreator!]!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type Artwork {
  id: ID!
  movieId: ID!
  url: String!
  type: ArtworkType!
}

enum ArtworkType {
  POSTER
  BACKDROP
  STILL
}

type Person {
  id: ID!
  name: String!
  biography: String
  birthDate: Date
  createdAt: DateTime!
  updatedAt: DateTime!
}

type MovieCast {
  id: ID!
  movieId: ID!
  person: Person!
  characterName: String!
}

type MovieCreator {
  id: ID!
  movieId: ID!
  person: Person!
  job: String!
}

input MovieInput {
  title: String!
  synopsis: String
  releaseYear: Int
  genre: String
}

input PersonInput {
  name: String!
  biography: String
  birthDate: Date
}

input CastInput {
  movieId: ID!
  personId: ID!
  characterName: String!
}

input CreatorInput {
  movieId: ID!
  personId: ID!
  job: String!
}

input MovieSort {
  field: MovieSortField!
  direction: SortDirection!
}

enum MovieSortField {
  TITLE
  RELEASE_YEAR
  CREATED_AT
}

enum SortDirection {
  ASC
  DESC
}

type MoviePage {
  items: [Movie!]!
  total: Int!
  page: Int!
  size: Int!
  totalPages: Int!
}

type PersonPage {
  items: [Person!]!
  total: Int!
  page: Int!
  size: Int!
  totalPages: Int!
}
