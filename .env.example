# Optional. Every value below has the same default already applied in
# docker-compose.yml, so `docker compose up --build` works with no .env file.
#
# Copy to `.env` only if you want to override something.
# Compose reads a file named exactly `.env` and nothing else.

DB_USERNAME=cinebase
DB_PASSWORD=cinebase
MOVIE_DB_NAME=movie_service
PERSON_DB_NAME=person_service

FRONTEND_PORT=3000
MOVIE_HTTP_PORT=8081
PERSON_HTTP_PORT=8082
PERSON_GRPC_PORT=9090
POSTGRES_PORT=5432

# Used by the frontend container only. Browser requests for /graphql and /uploads are proxied
# here, and server-side rendering queries it directly. It must be an address the frontend
# container can reach, so it is the Compose service name and never localhost.
# When running `npm run dev` on the host, SSR falls back to http://localhost:8081 instead.
MOVIE_SERVICE_ORIGIN=http://movie-service:8081
